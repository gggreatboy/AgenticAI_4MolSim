# ----------------- Run Section -----------------
# Setup timestep
timestep        1 #fs

# Define thermo output
thermo          1000
thermo_style    custom step time temp pe ke etotal enthalpy press lx vol density

#Create initial velocity distribution
velocity   all create 300 097865 dist gaussian

## Fix commands
fix 1 all npt temp 300 300 100 iso 1 1 1000.0

# Define Dumping
#dump 1 all xyz 1000 test.xyz
dump 3 all dcd 1000 npt_trajectory.dcd

run 1000000 # 1 ns
